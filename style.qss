/* 主窗口样式 */
QMainWindow {
    background-color: #F5F5F7;
    color: #000000;
}

/* 控制面板 */
QWidget#controlPanel {
    background-color: white;
    border-radius: 12px;
    padding: 16px;
    margin: 8px;
}

/* 搜索框 */
QLineEdit#searchEdit {
    border: 1px solid #C6C6C8;
    border-radius: 8px;
    padding: 8px 12px;
    background-color: white;
    font-size: 14px;
    min-width: 200px;
}

QLineEdit#searchEdit:focus {
    border-color: #007AFF;
    outline: none;
}

/* 按钮样式 */
QPushButton {
    background-color: #007AFF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    min-height: 32px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #0056CC;
}

QPushButton:pressed {
    background-color: #004499;
}

QPushButton:disabled {
    background-color: #E5E5EA;
    color: #8E8E93;
}

/* 删除按钮特殊样式 */
QPushButton#DeleteButton {
    background-color: #FF3B30;
}

QPushButton#DeleteButton:hover {
    background-color: #D70015;
}

/* 表格样式 */
QTableView {
    border: 1px solid #C6C6C8;
    border-radius: 12px;
    background-color: white;
    gridline-color: #F2F2F7;
    font-size: 14px;
    margin: 8px;
}

QTableView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F2F2F7;
}

QTableView::item:selected {
    background-color: #007AFF;
    color: white;
}

QTableView::item:hover {
    background-color: #F2F2F7;
}

/* 表头样式 */
QHeaderView::section {
    background-color: #6E7BA5;
    color: white;
    font-weight: bold;
    padding: 10px;
    border: none;
    font-size: 13px;
}

QHeaderView::section:first {
    border-top-left-radius: 11px;
}

QHeaderView::section:last {
    border-top-right-radius: 11px;
}

/* 状态标签 */
QLabel#statusLabel {
    color: #8E8E93;
    font-size: 12px;
    padding: 8px 16px;
    background-color: white;
    border-radius: 8px;
    margin: 8px;
}

/* 滚动条 */
QScrollBar:vertical {
    border: none;
    background-color: #F2F2F7;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #C6C6C8;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8E8E93;
}
